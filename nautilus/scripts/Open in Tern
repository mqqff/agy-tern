#!/bin/sh
dir=$(python3 -c '
import os, urllib.parse
uri = os.environ.get("NAUTILUS_SCRIPT_CURRENT_URI", "")
p = urllib.parse.urlparse(uri)
path = urllib.parse.unquote(p.path) if p.scheme == "file" else ""
print(path if path and os.path.isdir(path) else os.path.expanduser("~"))
')
TERN_BIN=$(command -v tern 2>/dev/null || printf '%s/.local/bin/tern' "$HOME")
exec "$TERN_BIN" "$dir"
