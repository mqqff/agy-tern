{
  "theme": "System",
  "theme_dark": "dark-abyss",
  "cursor": {
    "smooth_blink": true
  },
  "paste": {
    "confirm": false
  },
  "font_size": 15,
  "ui_font_size": 13,
  "agent_command": "tern acp codex",
  "opacity": 100,
  "agent_placement": "replace_if_alone",
  "snap_text": true,
  "agents": {
    "custom": [
      {
        "id": "agy-tern",
        "name": "Antigravity Tern",
        "command": "agy-tern",
        "args": [],
        "env": {}
      }
    ],
    "own_tools": [
      "agy-tern"
    ]
  },
  "keybinds": {
    "alt+1": [],
    "alt+2": [],
    "alt+3": [],
    "alt+4": [],
    "alt+5": [],
    "alt+6": [],
    "alt+7": [],
    "alt+8": [],
    "alt+9": [],
    "alt+digit_1": [],
    "alt+digit_2": [],
    "alt+digit_3": [],
    "alt+digit_4": [],
    "alt+digit_5": [],
    "alt+digit_6": [],
    "alt+digit_7": [],
    "alt+digit_8": [],
    "alt+digit_9": [],
    "ctrl+-": "decrease_font_size",
    "ctrl+0": "reset_font_size",
    "ctrl+1": "goto_tab:1",
    "ctrl+2": "goto_tab:2",
    "ctrl+3": "goto_tab:3",
    "ctrl+4": "goto_tab:4",
    "ctrl+5": "goto_tab:5",
    "ctrl+6": "goto_tab:6",
    "ctrl+7": "goto_tab:7",
    "ctrl+8": "goto_tab:8",
    "ctrl+9": "goto_tab:9",
    "ctrl+=": "increase_font_size",
    "ctrl+a": "plugin.agy-paste.ctrl-a",
    "ctrl+alt+shift+u": [],
    "ctrl+alt+shift+w": [],
    "ctrl+digit_0": "reset_font_size",
    "ctrl+digit_1": "goto_tab:1",
    "ctrl+digit_2": "goto_tab:2",
    "ctrl+digit_3": "goto_tab:3",
    "ctrl+digit_4": "goto_tab:4",
    "ctrl+digit_5": "goto_tab:5",
    "ctrl+digit_6": "goto_tab:6",
    "ctrl+digit_7": "goto_tab:7",
    "ctrl+digit_8": "goto_tab:8",
    "ctrl+digit_9": "goto_tab:9",
    "ctrl+end": "scroll_bottom",
    "ctrl+f": [
      "editor.find",
      "sqlite.browse.find",
      "find"
    ],
    "ctrl+home": "scroll_top",
    "ctrl+n": "new_window",
    "ctrl+page_down": "next_tab",
    "ctrl+page_up": "previous_tab",
    "ctrl+plus": "increase_font_size",
    "ctrl+shift+f": [],
    "ctrl+shift+left": [],
    "ctrl+shift+n": [],
    "ctrl+shift+page_down": "move_tab_right",
    "ctrl+shift+page_up": "move_tab_left",
    "ctrl+shift+q": [],
    "ctrl+shift+right": [],
    "ctrl+shift+t": "reopen_closed_tab",
    "ctrl+shift+tab": "previous_tab",
    "ctrl+shift+v": "edit.paste",
    "ctrl+t": "new_tab",
    "ctrl+tab": "next_tab",
    "ctrl+v": "paste",
    "ctrl+w": "close_tab",
    "shift+end": "scroll_bottom",
    "shift+home": "scroll_top",
    "shift+insert": "edit.paste",
    "shift+page_down": "scroll_page_down",
    "shift+page_up": "scroll_page_up"
